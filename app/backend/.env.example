# Example settings. Placeholders only: never commit real values.
# The app reads process environment variables. It never loads a .env file itself:
# export these in your shell, or set them in Vercel's environment settings.
# A plain local loopback run needs none of them.

# --- Hosting (required when hosted: on Vercel, or whenever ALLOWED_HOSTS is set) ---
# Signs the airport_context follow-up cookie. Must be 32-512 bytes.
# Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Rotating it invalidates every follow-up cookie.
# APP_SIGNING_KEY=<generate-a-random-value>
# Optional. Comma-separated extra hostnames, such as a custom domain. No scheme, path or port.
# Vercel's own VERCEL_URL, VERCEL_BRANCH_URL and VERCEL_PROJECT_PRODUCTION_URL hosts are added automatically.
# Setting this outside Vercel switches the app to hosted mode, which then requires APP_SIGNING_KEY.
# ALLOWED_HOSTS=analyst.example.com
# Optional. Concurrent analyses per instance, 1-16 (default: 4 when hosted, 1 locally).
# MAX_CONCURRENT_QUERIES=4

# --- Model (free text). Disabled unless every admission variable below matches. ---
# Put the key only in your shell or in Vercel's encrypted environment settings.
# Spend is capped by a hard monthly budget on the OpenAI project; the app has no spend ledger.
# OPENAI_API_KEY=<your-openai-key>
# OPENAI_MODEL=<model-id>
# Set these only after a passing live evaluation (see the README):
# MODEL_RUNTIME_ENABLED=false
# MODEL_ADMITTED_NAME=<same-as-OPENAI_MODEL>
# MODEL_ADMITTED_ADAPTER_SHA256=<sha256sum of app/backend/app/model_adapter.py>
# Optional, for reasoning models only. One of: none, minimal, low, medium, high.
# Leave it unset for non-reasoning models. Check which values the chosen model supports.
# A low value keeps reasoning tokens within the 512-token output cap.
# MODEL_REASONING_EFFORT=low

# --- Optional model-call bounds. The defaults are also the maximums. The 30 s query deadline is fixed in main.py. ---
# MAX_QUERY_CHARS=4000
# MODEL_TIMEOUT_SECONDS=20
# MODEL_MAX_OUTPUT_TOKENS=512
# MODEL_MAX_PROMPT_TOKENS=8000
